#!/bin/sh
#
# http://github.com/mitchweaver/bin
#
# nproc wrapper for various systems for compatibility
#

case $(uname) in
    Linux)
        exec /usr/bin/nproc
        ;;
    FreeBSD)
        exec /bin/nproc
        ;;
    OpenBSD)
        exec sysctl -n hw.ncpu
        ;;
    Darwin)
        exec sysctl -n hw.logicalcpu
esac

