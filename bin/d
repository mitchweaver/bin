#!/bin/sh
#
# http://github.com/mitchweaver
#
# "du for humans"
# -*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*

usage() {
    >&2 printf 'Usage: %s [-L links] <directory>\n' "${0##*/}"
    exit 1
}

case ${1#-} in
    h|-help)
        usage
        ;;
esac

# detect GNU sort vs BSD sort
if sort -h </dev/null 2>/dev/null; then
    SORT_FLAGS="-rh"
else
    SORT_FLAGS="-rn"
fi

if [ -d "${1:-.}" ] ; then
    if [ "$SORT_FLAGS" = "-rn" ]; then
        # BSD sort: sort numerically, convert to human-readable after
        find "${1:-.}" -maxdepth 1 -exec du -a {} \; 2>/dev/null | \
            sort $SORT_FLAGS | \
            head -n 20 | \
            awk '{printf "%-10s %s\n", $1, $2}'
    else
        # GNU sort: sort human-readable directly
        find "${1:-.}" -maxdepth 1 -exec du -ah {} \; 2>/dev/null | \
            sort $SORT_FLAGS | \
            head -n 20
    fi
elif [ -f "$1" ] ; then
    du -ah "$1"
fi

